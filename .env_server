# Server Configuration
PORT=3000
NODE_ENV=production

# FFmpeg Configuration
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Google Cloud Storage Configuration
GOOGLE_CLOUD_STORAGE_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=ffmep-api
GOOGLE_CLOUD_KEY_FILE=src/config/gcp-service-account.json
GOOGLE_CLOUD_BUCKET_NAME=ffmpeg-api

# Storage Configuration (local paths)
TEMP_DIR=./storage/temp
OUTPUT_DIR=./storage/output

# Cleanup Configuration
CLEANUP_INTERVAL_HOURS=1
TEMP_FILE_TTL_HOURS=1
OUTPUT_FILE_TTL_HOURS=24

# 💰 Cost Analysis Configuration - Contabo VPS S
# Baseado no seu plano: $6.60/mês, 4 vCPUs, 6GB RAM, Alemanha

# Server cost per hour in USD
SERVER_COST_PER_HOUR=0.009167

# Cloud provider name (for display in metrics)
CLOUD_PROVIDER=Contabo

# Instance type (for display in metrics)
INSTANCE_TYPE=VPS-S-4CPU-6GB

# Complexity factors (ajustados para sua VPS)
COMPLEXITY_FACTOR_LOW=0.6
COMPLEXITY_FACTOR_MEDIUM=1.8
COMPLEXITY_FACTOR_HIGH=3.5

# Additional cost factor (storage, bandwidth, overhead)
ADDITIONAL_COST_FACTOR=0.15

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Webhook Configuration (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Logging Configuration
LOG_LEVEL=info