# Credenciais e Segredos
REDIS_PASSWORD=sua_senha
GRAFANA_ADMIN_PASSWORD=sua_senha

# Google Cloud Storage (REQUIRED if GOOGLE_CLOUD_STORAGE_ENABLED=true)
GOOGLE_CLOUD_STORAGE_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_KEY_FILE=src/config/gcp-service-account.json
GOOGLE_CLOUD_BUCKET_NAME=your_bucket_name

# Webhook Configuration (REQUIRED)
WEBHOOK_URL=https://your-webhook-url.com
WEBHOOK_SECRET=your_webhook_secret

# Environment Configuration (OPTIONAL)
NODE_ENV=production
LOG_LEVEL=info

# FFmpeg Resource Configuration (OPTIONAL)
MAX_CONCURRENT_JOBS=1
FFMPEG_THREADS=4
FFMPEG_PRESET=faster
FFMPEG_MAX_MEMORY=8G
FFMPEG_PRIORITY=5
FFMPEG_BITRATE=3000k
FFMPEG_AUDIO_BITRATE=128k
FFMPEG_BUFFER_SIZE=4000k
FFMPEG_MAX_RATE=4000k

# Cost Analysis Configuration (OPTIONAL)
SERVER_COST_PER_HOUR=0.50
CLOUD_PROVIDER=gcp
INSTANCE_TYPE=e2-standard-4
COMPLEXITY_FACTOR_LOW=1.0
COMPLEXITY_FACTOR_MEDIUM=1.5
COMPLEXITY_FACTOR_HIGH=2.0
ADDITIONAL_COST_FACTOR=1.1
