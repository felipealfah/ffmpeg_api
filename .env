# Configurações de Ambiente
NODE_ENV=production
LOG_LEVEL=info

# Caminhos dos Binários
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Credenciais e Segredos
REDIS_PASSWORD=secure_redis_password_2025
GRAFANA_ADMIN_PASSWORD=admin123

# Google Cloud Storage
GOOGLE_CLOUD_STORAGE_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=ffmep-api
GOOGLE_CLOUD_KEY_FILE=src/config/gcp-service-account.json
GOOGLE_CLOUD_BUCKET_NAME=ffmpeg-api

# Webhook (opcional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# 💰 Cost Analysis Configuration - Contabo VPS
SERVER_COST_PER_HOUR=0.009167
CLOUD_PROVIDER=Contabo
INSTANCE_TYPE=VPS-6CPU-12GB
COMPLEXITY_FACTOR_LOW=0.6
COMPLEXITY_FACTOR_MEDIUM=1.8
COMPLEXITY_FACTOR_HIGH=3.5
ADDITIONAL_COST_FACTOR=0.15