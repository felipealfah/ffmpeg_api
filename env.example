# Configurações de Ambiente - Servidor Produção (10 vCPU, 62GB RAM)
NODE_ENV=production
LOG_LEVEL=info

# Caminhos dos Binários (Docker)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Configurações de Recursos e FFmpeg (otimizado para 10 vCPU, 62GB RAM)
MAX_CONCURRENT_JOBS=8
FFMPEG_THREADS=8

# Configurações de Memória (ajustado para 62GB RAM)
FFMPEG_MEMORY_LIMIT=8192  # 8GB por job (permite 8 jobs simultâneos)
FFMPEG_MAX_MEMORY=8G      # Mesmo limite em formato FFmpeg

# Configurações de Qualidade FFmpeg (otimizado para performance)
FFMPEG_PRESET=medium      # Qualidade/velocidade equilibrada
FFMPEG_PRIORITY=5
FFMPEG_BITRATE=4000k      # Bitrate mais alto para qualidade
FFMPEG_AUDIO_BITRATE=192k # Audio bitrate melhor
FFMPEG_BUFFER_SIZE=6000k  # Buffer maior para stability
FFMPEG_MAX_RATE=6000k     # Max rate maior
FFMPEG_MUXING_QUEUE_SIZE=2048  # Queue maior para jobs simultâneos
FFMPEG_CPU_USED=2         # Menor valor = melhor qualidade/performance

# Credenciais e Segredos
REDIS_PASSWORD=secure_redis_password_2025
GRAFANA_ADMIN_PASSWORD=admin123

# Google Cloud Storage (REQUIRED if GOOGLE_CLOUD_STORAGE_ENABLED=true)
GOOGLE_CLOUD_STORAGE_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_KEY_FILE=src/config/gcp-service-account.json
GOOGLE_CLOUD_BUCKET_NAME=ffmpeg-api

# Webhook (opcional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_API_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#ffmpeg-api-alerts

# 💰 Cost Analysis Configuration - Servidor Produção (10 vCPU, 62GB RAM, 400GB SSD)
SERVER_COST_PER_HOUR=0.015278  # Estimativa para servidor com mais recursos
CLOUD_PROVIDER=VMware
INSTANCE_TYPE=10CPU-62GB-400GB
COMPLEXITY_FACTOR_LOW=0.5
COMPLEXITY_FACTOR_MEDIUM=1.5
COMPLEXITY_FACTOR_HIGH=3.0
ADDITIONAL_COST_FACTOR=0.12