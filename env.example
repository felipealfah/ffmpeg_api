# FFmpeg API Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration
TEMP_DIR=./storage/temp
OUTPUT_DIR=./storage/output

# Cleanup Configuration
CLEANUP_INTERVAL_HOURS=1
TEMP_FILE_TTL_HOURS=1
OUTPUT_FILE_TTL_HOURS=24

# 💰 Cost Analysis Configuration
# Configure these values based on your actual server costs

# Server cost per hour in USD (default: DigitalOcean 16GB CPU-Optimized)
SERVER_COST_PER_HOUR=0.238

# Cloud provider name (for display in metrics)
CLOUD_PROVIDER=DigitalOcean

# Instance type (for display in metrics)
INSTANCE_TYPE=16GB CPU-Optimized

# Complexity factors (how much longer rendering takes vs video duration)
COMPLEXITY_FACTOR_LOW=0.5
COMPLEXITY_FACTOR_MEDIUM=1.5
COMPLEXITY_FACTOR_HIGH=3.0

# Additional cost factor (storage, bandwidth, overhead as percentage)
ADDITIONAL_COST_FACTOR=0.2

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Webhook Configuration (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Logging Configuration
LOG_LEVEL=info 